# ============================================================================
# Скопируйте в .env и замените значения-заглушки. Реальные секреты в репозиторий не попадают.
# Хосты (postgres, minio) — имена сервисов docker compose. Для запуска backend вне Docker
# замените их на localhost.
# ============================================================================

# --- PostgreSQL (контейнер postgres) ---
POSTGRES_USER=correspondence
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=correspondence
# Пароль в DATABASE_URL должен совпадать с POSTGRES_PASSWORD
DATABASE_URL=postgresql+asyncpg://correspondence:change_me_db_password@postgres:5432/correspondence

# --- JWT ---
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_to_a_long_random_string_of_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- S3 / MinIO ---
S3_ENDPOINT=http://minio:9000
# Используйте латиницу и цифры: ключи подставляются в URL для mc (scripts/backup_storage.sh)
S3_ACCESS_KEY=change_me_minio_user
S3_SECRET_KEY=change_me_minio_password_min_8
S3_BUCKET=correspondence
S3_REGION=us-east-1

# --- Бизнес-параметры ---
MAX_UPLOAD_SIZE_MB=20
# Плейсхолдеры: {YYYY}, {YY}, {NNNNNN} (число N = ширина номера)
REG_NUMBER_TEMPLATE=ВХ-{YYYY}-{NNNNNN}
# За сколько дней до срока документ получает признак «срок близок»
DEADLINE_WARNING_DAYS=3
# Часовой пояс организации (IANA): дата регистрации и контроль сроков считаются в нем
APP_TIMEZONE=Europe/Moscow

# --- Прочее ---
LOG_LEVEL=INFO
# Путь к TTF-шрифту с кириллицей для PDF (в Docker-образе шрифт DejaVu уже установлен)
# PDF_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
